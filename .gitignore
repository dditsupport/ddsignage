local.properties

# Release-signing secrets — keystore + passwords. The keystore.properties
# file is read by app/build.gradle.kts; Keys/ holds the .jks file itself.
# Lose either and OTA updates break across the entire fleet (signature
# mismatch on next install), so back them up off-machine.
keystore.properties
/Keys/

# Runtime PHP config templates are committed with placeholder values.
# When deploying, copy them and fill in real credentials — the copies
# should live OUTSIDE the docroot and MUST NOT be committed.
# Add any real-secret overrides here:
#   /config_dc/config.local.php
#   /cloudserver/config.local.php

# Committed SQL is schema-only (no INSERTs). Any dumps that include data
# should carry a .data.sql suffix and stay out of the repo.
*.data.sql

# Build outputs (Android + IDE cruft not covered above).
/app/build/
*.apk
*.aab
*.jks
*.keystore
